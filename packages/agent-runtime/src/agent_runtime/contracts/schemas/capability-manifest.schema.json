{
  "$defs": {
    "AgentCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "agent",
          "title": "Kind",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/RemoteAgentSpec"
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "title": "AgentCapability",
      "type": "object"
    },
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    },
    "CapabilitySpec": {
      "discriminator": {
        "mapping": {
          "agent": "#/$defs/AgentCapability",
          "hook": "#/$defs/HookCapability",
          "knowledge": "#/$defs/KnowledgeCapability",
          "model": "#/$defs/ModelCapability",
          "prompt": "#/$defs/PromptCapability",
          "skill": "#/$defs/SkillCapability",
          "tool": "#/$defs/ToolCapability"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ModelCapability"
        },
        {
          "$ref": "#/$defs/ToolCapability"
        },
        {
          "$ref": "#/$defs/SkillCapability"
        },
        {
          "$ref": "#/$defs/PromptCapability"
        },
        {
          "$ref": "#/$defs/HookCapability"
        },
        {
          "$ref": "#/$defs/KnowledgeCapability"
        },
        {
          "$ref": "#/$defs/AgentCapability"
        }
      ]
    },
    "HookCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hook",
          "title": "Kind",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/HookSpec"
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "title": "HookCapability",
      "type": "object"
    },
    "HookSpec": {
      "additionalProperties": false,
      "properties": {
        "failurePolicy": {
          "enum": [
            "block",
            "notify_retry"
          ],
          "title": "Failurepolicy",
          "type": "string"
        },
        "handler": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "ref": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "replay": {
          "enum": [
            "pure",
            "ledger"
          ],
          "title": "Replay",
          "type": "string"
        },
        "stage": {
          "enum": [
            "input",
            "context",
            "tool_arguments",
            "before_execute",
            "output",
            "terminal"
          ],
          "title": "Stage",
          "type": "string"
        },
        "timeoutSeconds": {
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        }
      },
      "required": [
        "ref",
        "handler",
        "stage",
        "order",
        "timeoutSeconds",
        "failurePolicy",
        "replay"
      ],
      "title": "HookSpec",
      "type": "object"
    },
    "JsonValue": {},
    "KnowledgeBinding": {
      "additionalProperties": false,
      "properties": {
        "accessPolicy": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "citationPolicy": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "ref": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "retrievalPolicy": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "source": {
          "$ref": "#/$defs/CapabilityRef"
        }
      },
      "required": [
        "ref",
        "source",
        "retrievalPolicy",
        "citationPolicy",
        "accessPolicy"
      ],
      "title": "KnowledgeBinding",
      "type": "object"
    },
    "KnowledgeCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "knowledge",
          "title": "Kind",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/KnowledgeBinding"
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "title": "KnowledgeCapability",
      "type": "object"
    },
    "McpToolBinding": {
      "additionalProperties": false,
      "description": "Immutable, host-approved remote identity and schemas; never a model-supplied URL.",
      "properties": {
        "cancelDestination": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cancelName": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7e]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancelname"
        },
        "destination": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "inputSchema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Inputschema",
          "type": "object"
        },
        "lookupDestination": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lookupName": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7e]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lookupname"
        },
        "outputSchema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Outputschema",
          "type": "object"
        },
        "protocolVersion": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Protocolversion",
          "type": "string"
        },
        "toolName": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Toolname",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "toolName",
        "destination",
        "inputSchema",
        "outputSchema"
      ],
      "title": "McpToolBinding",
      "type": "object"
    },
    "ModelCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "model",
          "title": "Kind",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/ModelConfig"
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "title": "ModelCapability",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "connection": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "maxOutputTokens": {
          "$ref": "#/$defs/PositiveInt"
        },
        "modelName": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Modelname",
          "type": "string"
        },
        "providerOptions": {
          "patternProperties": {
            "^[^\\s\\p{Cc}\\p{Cf}]+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "propertyNames": {
            "maxLength": 255,
            "minLength": 1
          },
          "title": "Provideroptions",
          "type": "object"
        },
        "ref": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "thinking": {
          "enum": [
            "default",
            "enabled",
            "disabled"
          ],
          "title": "Thinking",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "connection",
        "modelName",
        "maxOutputTokens",
        "thinking",
        "providerOptions"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "PositiveInt": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "PromptCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "prompt",
          "title": "Kind",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/PromptSpec"
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "title": "PromptCapability",
      "type": "object"
    },
    "PromptSpec": {
      "additionalProperties": false,
      "properties": {
        "contentDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contentdigest",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "templateRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Templateref",
          "type": "string"
        },
        "variables": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
            "type": "string"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "templateRef",
        "contentDigest",
        "variables"
      ],
      "title": "PromptSpec",
      "type": "object"
    },
    "PublicPolicy": {
      "enum": [
        "full",
        "summary",
        "reference_only"
      ],
      "type": "string"
    },
    "RemoteAgentSpec": {
      "additionalProperties": false,
      "properties": {
        "canCancelTask": {
          "title": "Cancanceltask",
          "type": "boolean"
        },
        "canQueryTask": {
          "title": "Canquerytask",
          "type": "boolean"
        },
        "cardDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Carddigest",
          "type": "string"
        },
        "credentialPolicy": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "endpoint": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "idempotency": {
          "enum": [
            "provider_key",
            "query",
            "unknown"
          ],
          "title": "Idempotency",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "ref": {
          "$ref": "#/$defs/CapabilityRef"
        }
      },
      "required": [
        "ref",
        "endpoint",
        "protocol",
        "cardDigest",
        "credentialPolicy",
        "canQueryTask",
        "canCancelTask",
        "idempotency"
      ],
      "title": "RemoteAgentSpec",
      "type": "object"
    },
    "SkillCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "skill",
          "title": "Kind",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/SkillSpec"
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "title": "SkillCapability",
      "type": "object"
    },
    "SkillSpec": {
      "additionalProperties": false,
      "properties": {
        "bundleDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Bundledigest",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/WorkspaceFile"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "gitCommit": {
          "anyOf": [
            {
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gitcommit"
        },
        "gitSubdir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gitsubdir"
        },
        "instructionPath": {
          "title": "Instructionpath",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "requiredTools": {
          "items": {
            "$ref": "#/$defs/CapabilityRef"
          },
          "title": "Requiredtools",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/CapabilityRef"
        }
      },
      "required": [
        "ref",
        "source",
        "gitCommit",
        "bundleDigest",
        "instructionPath",
        "files",
        "requiredTools"
      ],
      "title": "SkillSpec",
      "type": "object"
    },
    "ToolCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool",
          "title": "Kind",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/ToolSpec"
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "title": "ToolCapability",
      "type": "object"
    },
    "ToolSpec": {
      "additionalProperties": false,
      "properties": {
        "approvalPolicy": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "cancellation": {
          "enum": [
            "stop",
            "detach",
            "unsupported"
          ],
          "title": "Cancellation",
          "type": "string"
        },
        "concurrencyGroup": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Concurrencygroup",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "idempotency": {
          "enum": [
            "read_only",
            "transactional",
            "provider_key",
            "reconcile",
            "manual"
          ],
          "title": "Idempotency",
          "type": "string"
        },
        "inputSchema": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "kind": {
          "enum": [
            "read",
            "write",
            "control",
            "background",
            "interaction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maxConcurrency": {
          "exclusiveMinimum": 0,
          "title": "Maxconcurrency",
          "type": "integer"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpToolBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputSchema": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/CapabilityRef"
          },
          "title": "Permissions",
          "type": "array"
        },
        "publicResultPolicy": {
          "$ref": "#/$defs/PublicPolicy"
        },
        "ref": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "sideEffect": {
          "enum": [
            "none",
            "database",
            "external"
          ],
          "title": "Sideeffect",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "timeoutSeconds": {
          "exclusiveMinimum": 0,
          "title": "Timeoutseconds",
          "type": "integer"
        }
      },
      "required": [
        "ref",
        "description",
        "source",
        "kind",
        "sideEffect",
        "inputSchema",
        "outputSchema",
        "permissions",
        "approvalPolicy",
        "idempotency",
        "timeoutSeconds",
        "concurrencyGroup",
        "maxConcurrency",
        "cancellation",
        "publicResultPolicy"
      ],
      "title": "ToolSpec",
      "type": "object"
    },
    "WorkspaceFile": {
      "additionalProperties": false,
      "properties": {
        "blobRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Blobref",
          "type": "string"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "executable": {
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "blobRef",
        "digest",
        "sizeBytes"
      ],
      "title": "WorkspaceFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One immutable capability revision: identity, semantic kind, payload and digest.",
  "properties": {
    "contentDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contentdigest",
      "type": "string"
    },
    "ref": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "schemaRevision": {
      "const": 1,
      "default": 1,
      "title": "Schemarevision",
      "type": "integer"
    },
    "spec": {
      "$ref": "#/$defs/CapabilitySpec"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "revoked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "ref",
    "status",
    "contentDigest",
    "spec"
  ],
  "title": "CapabilityManifest",
  "type": "object"
}
