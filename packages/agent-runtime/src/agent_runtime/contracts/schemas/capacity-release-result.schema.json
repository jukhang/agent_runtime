{
  "$defs": {
    "CapacityReleaseApplied": {
      "additionalProperties": false,
      "description": "The first release of this reservation by the current request.",
      "properties": {
        "outcome": {
          "const": "applied",
          "title": "Outcome",
          "type": "string"
        },
        "releasedAt": {
          "format": "date-time",
          "title": "Releasedat",
          "type": "string"
        },
        "reservationId": {
          "format": "uuid",
          "title": "Reservationid",
          "type": "string"
        },
        "status": {
          "enum": [
            "released",
            "expired",
            "reclaimed"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "reservationId",
        "status",
        "version",
        "releasedAt"
      ],
      "title": "CapacityReleaseApplied",
      "type": "object"
    },
    "CapacityReleaseRejected": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "$ref": "#/$defs/FailureEnvelope"
        },
        "outcome": {
          "const": "rejected",
          "title": "Outcome",
          "type": "string"
        },
        "reservationId": {
          "format": "uuid",
          "title": "Reservationid",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "reservationId",
        "failure"
      ],
      "title": "CapacityReleaseRejected",
      "type": "object"
    },
    "CapacityReleaseReused": {
      "additionalProperties": false,
      "description": "Idempotent replay: the same request already released this reservation.",
      "properties": {
        "outcome": {
          "const": "reused",
          "title": "Outcome",
          "type": "string"
        },
        "releasedAt": {
          "format": "date-time",
          "title": "Releasedat",
          "type": "string"
        },
        "reservationId": {
          "format": "uuid",
          "title": "Reservationid",
          "type": "string"
        },
        "status": {
          "enum": [
            "released",
            "expired",
            "reclaimed"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "reservationId",
        "status",
        "version",
        "releasedAt"
      ],
      "title": "CapacityReleaseReused",
      "type": "object"
    },
    "FailureCategory": {
      "enum": [
        "validation",
        "authorization",
        "concurrency",
        "provider",
        "context",
        "storage",
        "tool",
        "budget",
        "compatibility",
        "delivery",
        "internal"
      ],
      "type": "string"
    },
    "FailureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attemptid"
        },
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "code": {
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "deadlineAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadlineat"
        },
        "detailRef": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detailref"
        },
        "operationId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operationid"
        },
        "partialResultRefs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Partialresultrefs",
          "type": "array"
        },
        "publicMessage": {
          "minLength": 1,
          "title": "Publicmessage",
          "type": "string"
        },
        "recoveryOptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecoveryOption"
          },
          "title": "Recoveryoptions",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schemaRevision": {
          "const": 1,
          "default": 1,
          "title": "Schemarevision",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "publicMessage"
      ],
      "title": "FailureEnvelope",
      "type": "object"
    },
    "RecoveryAction": {
      "enum": [
        "retry_same",
        "retry_with_compaction",
        "ask_user",
        "refresh_artifact",
        "reroute",
        "fallback_answer",
        "manual_attention"
      ],
      "type": "string"
    },
    "RecoveryOption": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/RecoveryAction"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "requiredInputSchemaRef": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requiredinputschemaref"
        }
      },
      "required": [
        "action",
        "label"
      ],
      "title": "RecoveryOption",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourceid",
          "type": "string"
        },
        "resourceType": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourcetype",
          "type": "string"
        },
        "resourceVersion": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourceversion"
        },
        "scope": {
          "$ref": "#/$defs/ResourceScope"
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "scope"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerid"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        }
      },
      "required": [
        "scopeId"
      ],
      "title": "ResourceScope",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "applied": "#/$defs/CapacityReleaseApplied",
      "rejected": "#/$defs/CapacityReleaseRejected",
      "reused": "#/$defs/CapacityReleaseReused"
    },
    "propertyName": "outcome"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CapacityReleaseApplied"
    },
    {
      "$ref": "#/$defs/CapacityReleaseReused"
    },
    {
      "$ref": "#/$defs/CapacityReleaseRejected"
    }
  ]
}
