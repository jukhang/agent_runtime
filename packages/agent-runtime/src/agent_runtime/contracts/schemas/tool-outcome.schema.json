{
  "$defs": {
    "ApprovalBinding": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Actorid",
          "type": "string"
        },
        "argumentsDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Argumentsdigest",
          "type": "string"
        },
        "authRevision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Authrevision",
          "type": "string"
        },
        "operationId": {
          "format": "uuid",
          "title": "Operationid",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Resources",
          "type": "array"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "format": "uuid",
          "title": "Sessionid",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/CapabilityRef"
        }
      },
      "required": [
        "scopeId",
        "actorId",
        "sessionId",
        "tool",
        "operationId",
        "argumentsDigest",
        "policy",
        "authRevision",
        "resources"
      ],
      "title": "ApprovalBinding",
      "type": "object"
    },
    "ApprovalRequest": {
      "additionalProperties": false,
      "properties": {
        "approvalId": {
          "format": "uuid",
          "title": "Approvalid",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/ApprovalBinding"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "idempotencyKey": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Idempotencykey",
          "type": "string"
        },
        "publicSummary": {
          "minLength": 1,
          "title": "Publicsummary",
          "type": "string"
        }
      },
      "required": [
        "approvalId",
        "binding",
        "idempotencyKey",
        "publicSummary",
        "expiresAt"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    },
    "FailureCategory": {
      "enum": [
        "validation",
        "authorization",
        "concurrency",
        "provider",
        "context",
        "storage",
        "tool",
        "budget",
        "compatibility",
        "delivery",
        "internal"
      ],
      "type": "string"
    },
    "FailureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attemptid"
        },
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "code": {
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "deadlineAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadlineat"
        },
        "detailRef": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detailref"
        },
        "operationId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operationid"
        },
        "partialResultRefs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Partialresultrefs",
          "type": "array"
        },
        "publicMessage": {
          "minLength": 1,
          "title": "Publicmessage",
          "type": "string"
        },
        "recoveryOptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecoveryOption"
          },
          "title": "Recoveryoptions",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schemaRevision": {
          "const": 1,
          "default": 1,
          "title": "Schemarevision",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "publicMessage"
      ],
      "title": "FailureEnvelope",
      "type": "object"
    },
    "FullResult": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/JsonValue"
        },
        "policy": {
          "const": "full",
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "data"
      ],
      "title": "FullResult",
      "type": "object"
    },
    "JsonValue": {},
    "PendingExecution": {
      "additionalProperties": false,
      "properties": {
        "executionRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "operationId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operationid"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "status": {
          "const": "pending_execution",
          "title": "Status",
          "type": "string"
        },
        "toolCallId": {
          "format": "uuid",
          "title": "Toolcallid",
          "type": "string"
        }
      },
      "required": [
        "toolCallId",
        "runId",
        "operationId",
        "status",
        "executionRef"
      ],
      "title": "PendingExecution",
      "type": "object"
    },
    "PublicToolResult": {
      "discriminator": {
        "mapping": {
          "full": "#/$defs/FullResult",
          "reference_only": "#/$defs/ReferenceResult",
          "summary": "#/$defs/SummaryResult"
        },
        "propertyName": "policy"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FullResult"
        },
        {
          "$ref": "#/$defs/SummaryResult"
        },
        {
          "$ref": "#/$defs/ReferenceResult"
        }
      ]
    },
    "RecoveryAction": {
      "enum": [
        "retry_same",
        "retry_with_compaction",
        "ask_user",
        "refresh_artifact",
        "reroute",
        "fallback_answer",
        "manual_attention"
      ],
      "type": "string"
    },
    "RecoveryOption": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/RecoveryAction"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "requiredInputSchemaRef": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requiredinputschemaref"
        }
      },
      "required": [
        "action",
        "label"
      ],
      "title": "RecoveryOption",
      "type": "object"
    },
    "ReferenceResult": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "reference_only",
          "title": "Policy",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "policy",
        "refs"
      ],
      "title": "ReferenceResult",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourceid",
          "type": "string"
        },
        "resourceType": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourcetype",
          "type": "string"
        },
        "resourceVersion": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourceversion"
        },
        "scope": {
          "$ref": "#/$defs/ResourceScope"
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "scope"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerid"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        }
      },
      "required": [
        "scopeId"
      ],
      "title": "ResourceScope",
      "type": "object"
    },
    "SummaryResult": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "summary",
          "title": "Policy",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "text"
      ],
      "title": "SummaryResult",
      "type": "object"
    },
    "ToolCancelled": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "none",
            "committed",
            "rolled_back",
            "unknown"
          ],
          "title": "Effect",
          "type": "string"
        },
        "effectRefs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Effectrefs",
          "type": "array"
        },
        "failure": {
          "$ref": "#/$defs/FailureEnvelope"
        },
        "operationId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operationid"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "status": {
          "const": "cancelled",
          "title": "Status",
          "type": "string"
        },
        "toolCallId": {
          "format": "uuid",
          "title": "Toolcallid",
          "type": "string"
        }
      },
      "required": [
        "toolCallId",
        "runId",
        "operationId",
        "effect",
        "effectRefs",
        "failure",
        "status"
      ],
      "title": "ToolCancelled",
      "type": "object"
    },
    "ToolCompleted": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "none",
            "committed",
            "rolled_back",
            "unknown"
          ],
          "title": "Effect",
          "type": "string"
        },
        "effectRefs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Effectrefs",
          "type": "array"
        },
        "operationId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operationid"
        },
        "result": {
          "$ref": "#/$defs/PublicToolResult"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "status": {
          "const": "completed",
          "title": "Status",
          "type": "string"
        },
        "toolCallId": {
          "format": "uuid",
          "title": "Toolcallid",
          "type": "string"
        }
      },
      "required": [
        "toolCallId",
        "runId",
        "operationId",
        "effect",
        "effectRefs",
        "status",
        "result"
      ],
      "title": "ToolCompleted",
      "type": "object"
    },
    "ToolFailed": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "none",
            "committed",
            "rolled_back",
            "unknown"
          ],
          "title": "Effect",
          "type": "string"
        },
        "effectRefs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Effectrefs",
          "type": "array"
        },
        "failure": {
          "$ref": "#/$defs/FailureEnvelope"
        },
        "operationId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operationid"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "toolCallId": {
          "format": "uuid",
          "title": "Toolcallid",
          "type": "string"
        }
      },
      "required": [
        "toolCallId",
        "runId",
        "operationId",
        "effect",
        "effectRefs",
        "failure",
        "status"
      ],
      "title": "ToolFailed",
      "type": "object"
    },
    "ToolNotExecuted": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "none",
            "committed",
            "rolled_back",
            "unknown"
          ],
          "title": "Effect",
          "type": "string"
        },
        "effectRefs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Effectrefs",
          "type": "array"
        },
        "failure": {
          "$ref": "#/$defs/FailureEnvelope"
        },
        "operationId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operationid"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "status": {
          "const": "not_executed",
          "title": "Status",
          "type": "string"
        },
        "toolCallId": {
          "format": "uuid",
          "title": "Toolcallid",
          "type": "string"
        }
      },
      "required": [
        "toolCallId",
        "runId",
        "operationId",
        "effect",
        "effectRefs",
        "failure",
        "status"
      ],
      "title": "ToolNotExecuted",
      "type": "object"
    },
    "ToolWaitingApproval": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalRequest"
        },
        "operationId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operationid"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "status": {
          "const": "waiting_approval",
          "title": "Status",
          "type": "string"
        },
        "toolCallId": {
          "format": "uuid",
          "title": "Toolcallid",
          "type": "string"
        }
      },
      "required": [
        "toolCallId",
        "runId",
        "operationId",
        "status",
        "approval"
      ],
      "title": "ToolWaitingApproval",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "cancelled": "#/$defs/ToolCancelled",
      "completed": "#/$defs/ToolCompleted",
      "failed": "#/$defs/ToolFailed",
      "not_executed": "#/$defs/ToolNotExecuted",
      "pending_execution": "#/$defs/PendingExecution",
      "waiting_approval": "#/$defs/ToolWaitingApproval"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ToolCompleted"
    },
    {
      "$ref": "#/$defs/ToolFailed"
    },
    {
      "$ref": "#/$defs/ToolCancelled"
    },
    {
      "$ref": "#/$defs/ToolNotExecuted"
    },
    {
      "$ref": "#/$defs/ToolWaitingApproval"
    },
    {
      "$ref": "#/$defs/PendingExecution"
    }
  ]
}
