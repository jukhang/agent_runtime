{
  "$defs": {
    "ActorContext": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Actorid",
          "type": "string"
        },
        "authRevision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Authrevision",
          "type": "string"
        },
        "grantsRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Grantsref",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "actorId",
        "authRevision",
        "grantsRef"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "MaintenanceLease": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Ownerid",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "workEpoch": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Workepoch",
          "type": "string"
        },
        "workId": {
          "format": "uuid",
          "title": "Workid",
          "type": "string"
        },
        "workLeaseUntil": {
          "format": "date-time",
          "title": "Workleaseuntil",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "workId",
        "ownerId",
        "workEpoch",
        "workLeaseUntil"
      ],
      "title": "MaintenanceLease",
      "type": "object"
    },
    "StaleRunRef": {
      "additionalProperties": false,
      "properties": {
        "expectedOwnerEpoch": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Expectedownerepoch",
          "type": "string"
        },
        "expectedStateVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Expectedstateversion",
          "type": "string"
        },
        "leaseUntil": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Leaseuntil"
        },
        "ownerId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ownerid"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "format": "uuid",
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "sessionId",
        "runId",
        "expectedStateVersion",
        "expectedOwnerEpoch",
        "ownerId",
        "leaseUntil"
      ],
      "title": "StaleRunRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorContext"
    },
    "lease": {
      "$ref": "#/$defs/MaintenanceLease"
    },
    "target": {
      "$ref": "#/$defs/StaleRunRef"
    }
  },
  "required": [
    "actor",
    "lease",
    "target"
  ],
  "title": "RecoveryRequest",
  "type": "object"
}
