{
  "$defs": {
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    },
    "DesiredControl": {
      "enum": [
        "pause",
        "cancel"
      ],
      "title": "DesiredControl",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "waiting_tool",
        "waiting_user",
        "paused",
        "cancelling",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "appliedInputSeq": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Appliedinputseq",
      "type": "string"
    },
    "cancelVersion": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Cancelversion",
      "type": "string"
    },
    "checkpointRef": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Checkpointref",
      "type": "string"
    },
    "desiredControl": {
      "anyOf": [
        {
          "$ref": "#/$defs/DesiredControl"
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingInputSeq": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Pendinginputseq",
      "type": "string"
    },
    "runId": {
      "format": "uuid",
      "title": "Runid",
      "type": "string"
    },
    "scopeId": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Scopeid",
      "type": "string"
    },
    "sessionId": {
      "format": "uuid",
      "title": "Sessionid",
      "type": "string"
    },
    "stateVersion": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Stateversion",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    }
  },
  "required": [
    "scopeId",
    "sessionId",
    "runId",
    "stateVersion",
    "checkpointRef",
    "agent",
    "status",
    "desiredControl",
    "cancelVersion",
    "pendingInputSeq",
    "appliedInputSeq"
  ],
  "title": "RunState",
  "type": "object"
}
