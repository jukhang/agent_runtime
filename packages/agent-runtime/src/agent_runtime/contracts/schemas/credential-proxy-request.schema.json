{
  "$defs": {
    "GrantRef": {
      "additionalProperties": false,
      "properties": {
        "executionGeneration": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executiongeneration"
        },
        "executionId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executionid"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "grantId": {
          "format": "uuid",
          "title": "Grantid",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        }
      },
      "required": [
        "grantId",
        "scopeId",
        "runId",
        "revision",
        "issuedAt",
        "expiresAt"
      ],
      "title": "GrantRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Action",
      "type": "string"
    },
    "grant": {
      "$ref": "#/$defs/GrantRef"
    },
    "requestDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Requestdigest",
      "type": "string"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "requestPayloadRef": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Requestpayloadref",
      "type": "string"
    }
  },
  "required": [
    "grant",
    "requestId",
    "action",
    "requestPayloadRef",
    "requestDigest"
  ],
  "title": "ProxyRequest",
  "type": "object"
}
