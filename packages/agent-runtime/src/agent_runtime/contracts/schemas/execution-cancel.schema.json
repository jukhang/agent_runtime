{
  "$defs": {
    "ActorContext": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Actorid",
          "type": "string"
        },
        "authRevision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Authrevision",
          "type": "string"
        },
        "grantsRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Grantsref",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "actorId",
        "authRevision",
        "grantsRef"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "MaintenanceLease": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Ownerid",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "workEpoch": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Workepoch",
          "type": "string"
        },
        "workId": {
          "format": "uuid",
          "title": "Workid",
          "type": "string"
        },
        "workLeaseUntil": {
          "format": "date-time",
          "title": "Workleaseuntil",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "workId",
        "ownerId",
        "workEpoch",
        "workLeaseUntil"
      ],
      "title": "MaintenanceLease",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourceid",
          "type": "string"
        },
        "resourceType": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourcetype",
          "type": "string"
        },
        "resourceVersion": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourceversion"
        },
        "scope": {
          "$ref": "#/$defs/ResourceScope"
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "scope"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerid"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        }
      },
      "required": [
        "scopeId"
      ],
      "title": "ResourceScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorContext"
    },
    "commandId": {
      "format": "uuid",
      "title": "Commandid",
      "type": "string"
    },
    "deadlineAt": {
      "format": "date-time",
      "title": "Deadlineat",
      "type": "string"
    },
    "executionRef": {
      "$ref": "#/$defs/ResourceRef"
    },
    "expectedCancelVersion": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Expectedcancelversion",
      "type": "string"
    },
    "generation": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Generation",
      "type": "string"
    },
    "lease": {
      "$ref": "#/$defs/MaintenanceLease"
    },
    "rootRunId": {
      "format": "uuid",
      "title": "Rootrunid",
      "type": "string"
    }
  },
  "required": [
    "actor",
    "lease",
    "executionRef",
    "generation",
    "commandId",
    "rootRunId",
    "expectedCancelVersion",
    "deadlineAt"
  ],
  "title": "ExecutionCancelRequest",
  "type": "object"
}
