{
  "$defs": {
    "ActorContext": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Actorid",
          "type": "string"
        },
        "authRevision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Authrevision",
          "type": "string"
        },
        "grantsRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Grantsref",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "actorId",
        "authRevision",
        "grantsRef"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    },
    "MaintenanceCredentialLease": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Epoch",
          "type": "string"
        },
        "leaseUntil": {
          "format": "date-time",
          "title": "Leaseuntil",
          "type": "string"
        },
        "ownerId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Ownerid",
          "type": "string"
        },
        "workId": {
          "format": "uuid",
          "title": "Workid",
          "type": "string"
        }
      },
      "required": [
        "workId",
        "ownerId",
        "epoch",
        "leaseUntil"
      ],
      "title": "MaintenanceCredentialLease",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "actor": {
      "$ref": "#/$defs/ActorContext"
    },
    "destination": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "executionGeneration": {
      "anyOf": [
        {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executiongeneration"
    },
    "executionId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executionid"
    },
    "expiresAt": {
      "format": "date-time",
      "title": "Expiresat",
      "type": "string"
    },
    "inputDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Inputdigest",
      "type": "string"
    },
    "maintenanceLease": {
      "anyOf": [
        {
          "$ref": "#/$defs/MaintenanceCredentialLease"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "maxRequests": {
      "minimum": 1,
      "title": "Maxrequests",
      "type": "integer"
    },
    "maxResponseBytes": {
      "minimum": 1,
      "title": "Maxresponsebytes",
      "type": "integer"
    },
    "operationId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operationid"
    },
    "policyDecisionId": {
      "format": "uuid",
      "title": "Policydecisionid",
      "type": "string"
    },
    "runId": {
      "format": "uuid",
      "title": "Runid",
      "type": "string"
    },
    "sessionId": {
      "format": "uuid",
      "title": "Sessionid",
      "type": "string"
    },
    "toolCallId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Toolcallid"
    }
  },
  "required": [
    "actor",
    "sessionId",
    "runId",
    "destination",
    "actions",
    "policyDecisionId",
    "inputDigest",
    "expiresAt",
    "maxRequests",
    "maxResponseBytes"
  ],
  "title": "ScopeRequest",
  "type": "object"
}
