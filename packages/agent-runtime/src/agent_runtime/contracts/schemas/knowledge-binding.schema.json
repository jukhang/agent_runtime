{
  "$defs": {
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accessPolicy": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "citationPolicy": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "ref": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "retrievalPolicy": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "source": {
      "$ref": "#/$defs/CapabilityRef"
    }
  },
  "required": [
    "ref",
    "source",
    "retrievalPolicy",
    "citationPolicy",
    "accessPolicy"
  ],
  "title": "KnowledgeBinding",
  "type": "object"
}
