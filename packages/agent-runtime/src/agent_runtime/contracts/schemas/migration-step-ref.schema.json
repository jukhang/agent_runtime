{
  "$defs": {
    "MigrationChain": {
      "enum": [
        "host",
        "runtime"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Structured proof of one applied step; a bare key cannot prove ancestry.",
  "properties": {
    "chain": {
      "$ref": "#/$defs/MigrationChain"
    },
    "fromRevision": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Fromrevision",
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[\\x21-\\x7e]+$",
      "title": "Idempotencykey",
      "type": "string"
    },
    "toRevision": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Torevision",
      "type": "string"
    }
  },
  "required": [
    "chain",
    "fromRevision",
    "toRevision",
    "idempotencyKey"
  ],
  "title": "MigrationStepRef",
  "type": "object"
}
