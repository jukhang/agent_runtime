{
  "$defs": {
    "ActorContext": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Actorid",
          "type": "string"
        },
        "authRevision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Authrevision",
          "type": "string"
        },
        "grantsRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Grantsref",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "actorId",
        "authRevision",
        "grantsRef"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    },
    "ChildRunRef": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "budgetAllocationId": {
          "format": "uuid",
          "title": "Budgetallocationid",
          "type": "string"
        },
        "childRunId": {
          "format": "uuid",
          "title": "Childrunid",
          "type": "string"
        },
        "parentRunId": {
          "format": "uuid",
          "title": "Parentrunid",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "format": "uuid",
          "title": "Sessionid",
          "type": "string"
        },
        "taskId": {
          "format": "uuid",
          "title": "Taskid",
          "type": "string"
        },
        "workspaceId": {
          "format": "uuid",
          "title": "Workspaceid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "sessionId",
        "parentRunId",
        "childRunId",
        "taskId",
        "agent",
        "budgetAllocationId",
        "workspaceId"
      ],
      "title": "ChildRunRef",
      "type": "object"
    },
    "CommitGuard": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorContext"
        },
        "expectedStateVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Expectedstateversion",
          "type": "string"
        },
        "lease": {
          "$ref": "#/$defs/LeaseToken"
        }
      },
      "required": [
        "actor",
        "lease",
        "expectedStateVersion"
      ],
      "title": "CommitGuard",
      "type": "object"
    },
    "LeaseToken": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Ownerid",
          "type": "string"
        },
        "runEpoch": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Runepoch",
          "type": "string"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "runLeaseUntil": {
          "format": "date-time",
          "title": "Runleaseuntil",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "format": "uuid",
          "title": "Sessionid",
          "type": "string"
        },
        "slotVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Slotversion",
          "type": "string"
        },
        "workEpoch": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Workepoch",
          "type": "string"
        },
        "workId": {
          "format": "uuid",
          "title": "Workid",
          "type": "string"
        },
        "workLeaseUntil": {
          "format": "date-time",
          "title": "Workleaseuntil",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "sessionId",
        "runId",
        "workId",
        "ownerId",
        "runEpoch",
        "workEpoch",
        "slotVersion",
        "runLeaseUntil",
        "workLeaseUntil"
      ],
      "title": "LeaseToken",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptanceSpec": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "child": {
      "$ref": "#/$defs/ChildRunRef"
    },
    "expectedProposalRevision": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Expectedproposalrevision",
      "type": "string"
    },
    "parentGuard": {
      "$ref": "#/$defs/CommitGuard"
    },
    "proposalId": {
      "format": "uuid",
      "title": "Proposalid",
      "type": "string"
    }
  },
  "required": [
    "parentGuard",
    "child",
    "proposalId",
    "expectedProposalRevision",
    "acceptanceSpec"
  ],
  "title": "CollectRequest",
  "type": "object"
}
