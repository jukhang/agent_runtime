{
  "$defs": {
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contentDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contentdigest",
      "type": "string"
    },
    "ref": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "templateRef": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Templateref",
      "type": "string"
    },
    "variables": {
      "items": {
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
        "type": "string"
      },
      "title": "Variables",
      "type": "array"
    }
  },
  "required": [
    "ref",
    "templateRef",
    "contentDigest",
    "variables"
  ],
  "title": "PromptSpec",
  "type": "object"
}
