{
  "additionalProperties": false,
  "properties": {
    "disposition": {
      "enum": [
        "accepted",
        "duplicate"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "messageId": {
      "format": "uuid",
      "title": "Messageid",
      "type": "string"
    },
