      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Recipientseq",
      "type": "string"
    },
    "scopeId": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Scopeid",
      "type": "string"
    }
  },
  "required": [
    "scopeId",
    "messageId",
    "recipientRunId",
    "recipientSeq",
    "disposition"
  ],
  "title": "MailboxReceipt",
  "type": "object"
