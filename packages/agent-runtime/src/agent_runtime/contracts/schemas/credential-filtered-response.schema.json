{
  "$defs": {
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "auditRef": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Auditref",
      "type": "string"
    },
    "bodyDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bodydigest",
      "type": "string"
    },
    "bodyRef": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Bodyref",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "allowed",
        "redacted",
        "blocked"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "filterPolicy": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "grantId": {
      "format": "uuid",
      "title": "Grantid",
      "type": "string"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "sizeBytes": {
      "minimum": 0,
      "title": "Sizebytes",
      "type": "integer"
    },
    "statusCode": {
      "maximum": 599,
      "minimum": 100,
      "title": "Statuscode",
      "type": "integer"
    }
  },
  "required": [
    "requestId",
    "grantId",
    "statusCode",
    "bodyRef",
    "bodyDigest",
    "sizeBytes",
    "filterPolicy",
    "auditRef",
    "disposition"
  ],
  "title": "FilteredResponse",
  "type": "object"
}
