{
  "$defs": {
    "CapacityKey": {
      "additionalProperties": false,
      "description": "Identity of one platform capacity counter; there is no user scope here.",
      "properties": {
        "deploymentId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Deploymentid",
          "type": "string"
        },
        "resourceKey": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Resourcekey",
          "type": "string"
        },
        "resourceKind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "resourceVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Resourceversion",
          "type": "string"
        }
      },
      "required": [
        "deploymentId",
        "resourceKind",
        "resourceVersion",
        "resourceKey"
      ],
      "title": "CapacityKey",
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "model_slot",
        "tool_slot",
        "run_slot",
        "sandbox_slot",
        "egress_slot"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "amount": {
      "maximum": 1024,
      "minimum": 1,
      "title": "Amount",
      "type": "integer"
    },
    "deadlineAt": {
      "format": "date-time",
      "title": "Deadlineat",
      "type": "string"
    },
    "holderRef": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Holderref",
      "type": "string"
    },
    "key": {
      "$ref": "#/$defs/CapacityKey"
    },
    "leaseUntil": {
      "format": "date-time",
      "title": "Leaseuntil",
      "type": "string"
    },
    "requestId": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[\\x21-\\x7e]+$",
      "title": "Requestid",
      "type": "string"
    }
  },
  "required": [
    "key",
    "amount",
    "holderRef",
    "requestId",
    "leaseUntil",
    "deadlineAt"
  ],
  "title": "CapacityReserveRequest",
  "type": "object"
}
