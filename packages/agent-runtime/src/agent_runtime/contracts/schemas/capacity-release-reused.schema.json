{
  "additionalProperties": false,
  "description": "Idempotent replay: the same request already released this reservation.",
  "properties": {
    "outcome": {
      "const": "reused",
      "title": "Outcome",
      "type": "string"
    },
    "releasedAt": {
      "format": "date-time",
      "title": "Releasedat",
      "type": "string"
    },
    "reservationId": {
      "format": "uuid",
      "title": "Reservationid",
      "type": "string"
    },
    "status": {
      "enum": [
        "released",
        "expired",
        "reclaimed"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "reservationId",
    "status",
    "version",
    "releasedAt"
  ],
  "title": "CapacityReleaseReused",
  "type": "object"
}
