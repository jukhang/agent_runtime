{
  "$defs": {
    "FailureCategory": {
      "enum": [
        "validation",
        "authorization",
        "concurrency",
        "provider",
        "context",
        "storage",
        "tool",
        "budget",
        "compatibility",
        "delivery",
        "internal"
      ],
      "type": "string"
    },
    "FailureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attemptid"
        },
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "code": {
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "deadlineAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadlineat"
        },
        "detailRef": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detailref"
        },
        "operationId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operationid"
        },
        "partialResultRefs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Partialresultrefs",
          "type": "array"
        },
        "publicMessage": {
          "minLength": 1,
          "title": "Publicmessage",
          "type": "string"
        },
        "recoveryOptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecoveryOption"
          },
          "title": "Recoveryoptions",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schemaRevision": {
          "const": 1,
          "default": 1,
          "title": "Schemarevision",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "publicMessage"
      ],
      "title": "FailureEnvelope",
      "type": "object"
    },
    "MigrationChain": {
      "enum": [
        "host",
        "runtime"
      ],
      "type": "string"
    },
    "MigrationDeferralReason": {
      "enum": [
        "host_failed",
        "runtime_failed",
        "lock_held",
        "incompatible"
      ],
      "type": "string"
    },
    "MigrationDeferred": {
      "additionalProperties": false,
      "description": "Retryable state: nothing was rolled back and the same plan may be replayed.",
      "properties": {
        "completed": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MigrationStepRef"
          },
          "title": "Completed",
          "type": "array"
        },
        "deploymentId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Deploymentid",
          "type": "string"
        },
        "disposition": {
          "const": "deferred",
          "title": "Disposition",
          "type": "string"
        },
        "planDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plandigest",
          "type": "string"
        },
        "planId": {
          "format": "uuid",
          "title": "Planid",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/MigrationDeferralReason"
        },
        "retryAfterSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retryafterseconds"
        }
      },
      "required": [
        "disposition",
        "planId",
        "planDigest",
        "deploymentId",
        "reason"
      ],
      "title": "MigrationDeferred",
      "type": "object"
    },
    "MigrationRejected": {
      "additionalProperties": false,
      "properties": {
        "deploymentId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Deploymentid",
          "type": "string"
        },
        "disposition": {
          "const": "rejected",
          "title": "Disposition",
          "type": "string"
        },
        "failure": {
          "$ref": "#/$defs/FailureEnvelope"
        },
        "planId": {
          "format": "uuid",
          "title": "Planid",
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "planId",
        "deploymentId",
        "failure"
      ],
      "title": "MigrationRejected",
      "type": "object"
    },
    "MigrationStepRef": {
      "additionalProperties": false,
      "description": "Structured proof of one applied step; a bare key cannot prove ancestry.",
      "properties": {
        "chain": {
          "$ref": "#/$defs/MigrationChain"
        },
        "fromRevision": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Fromrevision",
          "type": "string"
        },
        "idempotencyKey": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Idempotencykey",
          "type": "string"
        },
        "toRevision": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Torevision",
          "type": "string"
        }
      },
      "required": [
        "chain",
        "fromRevision",
        "toRevision",
        "idempotencyKey"
      ],
      "title": "MigrationStepRef",
      "type": "object"
    },
    "MigrationSucceeded": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "items": {
            "$ref": "#/$defs/MigrationStepRef"
          },
          "minItems": 1,
          "title": "Applied",
          "type": "array"
        },
        "deploymentId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Deploymentid",
          "type": "string"
        },
        "disposition": {
          "const": "succeeded",
          "title": "Disposition",
          "type": "string"
        },
        "hostRevision": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hostrevision"
        },
        "planDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plandigest",
          "type": "string"
        },
        "planId": {
          "format": "uuid",
          "title": "Planid",
          "type": "string"
        },
        "runtimeRevision": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Runtimerevision"
        }
      },
      "required": [
        "disposition",
        "planId",
        "planDigest",
        "deploymentId",
        "hostRevision",
        "runtimeRevision",
        "applied"
      ],
      "title": "MigrationSucceeded",
      "type": "object"
    },
    "RecoveryAction": {
      "enum": [
        "retry_same",
        "retry_with_compaction",
        "ask_user",
        "refresh_artifact",
        "reroute",
        "fallback_answer",
        "manual_attention"
      ],
      "type": "string"
    },
    "RecoveryOption": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/RecoveryAction"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "requiredInputSchemaRef": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requiredinputschemaref"
        }
      },
      "required": [
        "action",
        "label"
      ],
      "title": "RecoveryOption",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourceid",
          "type": "string"
        },
        "resourceType": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourcetype",
          "type": "string"
        },
        "resourceVersion": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourceversion"
        },
        "scope": {
          "$ref": "#/$defs/ResourceScope"
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "scope"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerid"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        }
      },
      "required": [
        "scopeId"
      ],
      "title": "ResourceScope",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "deferred": "#/$defs/MigrationDeferred",
      "rejected": "#/$defs/MigrationRejected",
      "succeeded": "#/$defs/MigrationSucceeded"
    },
    "propertyName": "disposition"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/MigrationSucceeded"
    },
    {
      "$ref": "#/$defs/MigrationDeferred"
    },
    {
      "$ref": "#/$defs/MigrationRejected"
    }
  ]
}
