{
  "$defs": {
    "ActorContext": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Actorid",
          "type": "string"
        },
        "authRevision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Authrevision",
          "type": "string"
        },
        "grantsRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Grantsref",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "actorId",
        "authRevision",
        "grantsRef"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    },
    "CommitGuard": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorContext"
        },
        "expectedStateVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Expectedstateversion",
          "type": "string"
        },
        "lease": {
          "$ref": "#/$defs/LeaseToken"
        }
      },
      "required": [
        "actor",
        "lease",
        "expectedStateVersion"
      ],
      "title": "CommitGuard",
      "type": "object"
    },
    "InputRequired": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "replyToRunId": {
          "format": "uuid",
          "title": "Replytorunid",
          "type": "string"
        },
        "requiredFacts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Requiredfacts",
          "type": "array"
        },
        "stateVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Stateversion",
          "type": "string"
        }
      },
      "required": [
        "stateVersion",
        "question",
        "requiredFacts",
        "replyToRunId"
      ],
      "title": "InputRequired",
      "type": "object"
    },
    "InputWatermark": {
      "additionalProperties": false,
      "properties": {
        "appliedVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Appliedversion",
          "type": "string"
        },
        "pendingVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Pendingversion",
          "type": "string"
        }
      },
      "required": [
        "pendingVersion",
        "appliedVersion"
      ],
      "title": "InputWatermark",
      "type": "object"
    },
    "LeaseToken": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Ownerid",
          "type": "string"
        },
        "runEpoch": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Runepoch",
          "type": "string"
        },
        "runId": {
          "format": "uuid",
          "title": "Runid",
          "type": "string"
        },
        "runLeaseUntil": {
          "format": "date-time",
          "title": "Runleaseuntil",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "format": "uuid",
          "title": "Sessionid",
          "type": "string"
        },
        "slotVersion": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Slotversion",
          "type": "string"
        },
        "workEpoch": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Workepoch",
          "type": "string"
        },
        "workId": {
          "format": "uuid",
          "title": "Workid",
          "type": "string"
        },
        "workLeaseUntil": {
          "format": "date-time",
          "title": "Workleaseuntil",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "sessionId",
        "runId",
        "workId",
        "ownerId",
        "runEpoch",
        "workEpoch",
        "slotVersion",
        "runLeaseUntil",
        "workLeaseUntil"
      ],
      "title": "LeaseToken",
      "type": "object"
    },
    "WaitSpec": {
      "additionalProperties": false,
      "properties": {
        "deadlineAt": {
          "format": "date-time",
          "title": "Deadlineat",
          "type": "string"
        },
        "kind": {
          "enum": [
            "tool",
            "approval",
            "message",
            "timer",
            "external"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resumePredicate": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "subjectId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Subjectid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subjectId",
        "deadlineAt",
        "resumePredicate"
      ],
      "title": "WaitSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpointId": {
      "format": "uuid",
      "title": "Checkpointid",
      "type": "string"
    },
    "guard": {
      "$ref": "#/$defs/CommitGuard"
    },
    "inputRequest": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputRequired"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inputs": {
      "$ref": "#/$defs/InputWatermark"
    },
    "waitSpec": {
      "$ref": "#/$defs/WaitSpec"
    }
  },
  "required": [
    "guard",
    "checkpointId",
    "waitSpec",
    "inputs"
  ],
  "title": "YieldRequest",
  "type": "object"
}
