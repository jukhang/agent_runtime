{
  "$defs": {
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Trusted registry configuration, never an endpoint supplied by the model.",
  "properties": {
    "action": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Action",
      "type": "string"
    },
    "destination": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "hostname": {
      "title": "Hostname",
      "type": "string"
    },
    "method": {
      "enum": [
        "GET",
        "POST"
      ],
      "title": "Method",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "port": {
      "default": 443,
      "maximum": 65535,
      "minimum": 1,
      "title": "Port",
      "type": "integer"
    },
    "privateAddresses": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Privateaddresses",
      "type": "array"
    }
  },
  "required": [
    "destination",
    "hostname",
    "action",
    "method",
    "path"
  ],
  "title": "EgressDestination",
  "type": "object"
}
