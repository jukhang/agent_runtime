{
  "$defs": {
    "CapabilityKey": {
      "additionalProperties": false,
      "description": "Stable non-scoped identity of a capability inside one namespace.",
      "properties": {
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "CapabilityKey",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Public reference to one fixed capability revision.",
      "properties": {
        "key": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "title": "CapabilityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "failurePolicy": {
      "enum": [
        "block",
        "notify_retry"
      ],
      "title": "Failurepolicy",
      "type": "string"
    },
    "handler": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "order": {
      "minimum": 0,
      "title": "Order",
      "type": "integer"
    },
    "ref": {
      "$ref": "#/$defs/CapabilityRef"
    },
    "replay": {
      "enum": [
        "pure",
        "ledger"
      ],
      "title": "Replay",
      "type": "string"
    },
    "stage": {
      "enum": [
        "input",
        "context",
        "tool_arguments",
        "before_execute",
        "output",
        "terminal"
      ],
      "title": "Stage",
      "type": "string"
    },
    "timeoutSeconds": {
      "minimum": 1,
      "title": "Timeoutseconds",
      "type": "integer"
    }
  },
  "required": [
    "ref",
    "handler",
    "stage",
    "order",
    "timeoutSeconds",
    "failurePolicy",
    "replay"
  ],
  "title": "HookSpec",
  "type": "object"
}
