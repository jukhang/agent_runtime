{
  "$defs": {
    "AnalysisDelta": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "format": "uuid",
          "title": "Attemptid",
          "type": "string"
        },
        "kind": {
          "const": "analysis.delta",
          "title": "Kind",
          "type": "string"
        },
        "sequence": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "sequence",
        "kind",
        "text"
      ],
      "title": "AnalysisDelta",
      "type": "object"
    },
    "ContentDelta": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "format": "uuid",
          "title": "Attemptid",
          "type": "string"
        },
        "kind": {
          "const": "content.delta",
          "title": "Kind",
          "type": "string"
        },
        "sequence": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "sequence",
        "kind",
        "text"
      ],
      "title": "ContentDelta",
      "type": "object"
    },
    "FailureCategory": {
      "enum": [
        "validation",
        "authorization",
        "concurrency",
        "provider",
        "context",
        "storage",
        "tool",
        "budget",
        "compatibility",
        "delivery",
        "internal"
      ],
      "type": "string"
    },
    "FailureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attemptid"
        },
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "code": {
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "deadlineAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadlineat"
        },
        "detailRef": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detailref"
        },
        "operationId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operationid"
        },
        "partialResultRefs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Partialresultrefs",
          "type": "array"
        },
        "publicMessage": {
          "minLength": 1,
          "title": "Publicmessage",
          "type": "string"
        },
        "recoveryOptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecoveryOption"
          },
          "title": "Recoveryoptions",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schemaRevision": {
          "const": 1,
          "default": 1,
          "title": "Schemarevision",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "publicMessage"
      ],
      "title": "FailureEnvelope",
      "type": "object"
    },
    "JsonValue": {},
    "ProviderError": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "format": "uuid",
          "title": "Attemptid",
          "type": "string"
        },
        "failure": {
          "$ref": "#/$defs/FailureEnvelope"
        },
        "kind": {
          "const": "error",
          "title": "Kind",
          "type": "string"
        },
        "sequence": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "sequence",
        "kind",
        "failure"
      ],
      "title": "ProviderError",
      "type": "object"
    },
    "ProviderFinish": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "format": "uuid",
          "title": "Attemptid",
          "type": "string"
        },
        "kind": {
          "const": "finish",
          "title": "Kind",
          "type": "string"
        },
        "rawReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rawreason"
        },
        "reason": {
          "enum": [
            "stop",
            "tool_calls",
            "length",
            "content_filter",
            "cancelled",
            "unknown"
          ],
          "title": "Reason",
          "type": "string"
        },
        "sequence": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "sequence",
        "kind",
        "reason",
        "rawReason"
      ],
      "title": "ProviderFinish",
      "type": "object"
    },
    "ProviderUsage": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "format": "uuid",
          "title": "Attemptid",
          "type": "string"
        },
        "kind": {
          "const": "usage",
          "title": "Kind",
          "type": "string"
        },
        "sequence": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "attemptId",
        "sequence",
        "kind",
        "usage"
      ],
      "title": "ProviderUsage",
      "type": "object"
    },
    "RecoveryAction": {
      "enum": [
        "retry_same",
        "retry_with_compaction",
        "ask_user",
        "refresh_artifact",
        "reroute",
        "fallback_answer",
        "manual_attention"
      ],
      "type": "string"
    },
    "RecoveryOption": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/RecoveryAction"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "requiredInputSchemaRef": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requiredinputschemaref"
        }
      },
      "required": [
        "action",
        "label"
      ],
      "title": "RecoveryOption",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourceid",
          "type": "string"
        },
        "resourceType": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Resourcetype",
          "type": "string"
        },
        "resourceVersion": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourceversion"
        },
        "scope": {
          "$ref": "#/$defs/ResourceScope"
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "scope"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerid"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        }
      },
      "required": [
        "scopeId"
      ],
      "title": "ResourceScope",
      "type": "object"
    },
    "ToolArgumentsDelta": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "format": "uuid",
          "title": "Attemptid",
          "type": "string"
        },
        "callId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Callid",
          "type": "string"
        },
        "kind": {
          "const": "tool.arguments.delta",
          "title": "Kind",
          "type": "string"
        },
        "sequence": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "sequence",
        "kind",
        "callId",
        "text"
      ],
      "title": "ToolArgumentsDelta",
      "type": "object"
    },
    "ToolCallComplete": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "attemptId": {
          "format": "uuid",
          "title": "Attemptid",
          "type": "string"
        },
        "callId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Callid",
          "type": "string"
        },
        "kind": {
          "const": "tool.complete",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Name",
          "type": "string"
        },
        "sequence": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "sequence",
        "kind",
        "callId",
        "name",
        "arguments"
      ],
      "title": "ToolCallComplete",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Reported token usage and *how* it is known (DS-P02-00 frozen matrix).\n\n``reason`` records provenance, not accuracy: a provider report, an absent provider\nreport, a failed collection, or a runtime estimate. Unknown usage must never be\nsettled as zero, so the status/reason pair is constrained:\n\n- ``complete`` requires a provider report plus all counts;\n- ``partial`` requires a provider report or an estimate;\n- ``unknown`` forbids a provider report.",
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inputtokens"
        },
        "outputTokens": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outputtokens"
        },
        "reason": {
          "enum": [
            "provider_reported",
            "provider_not_reported",
            "collection_failed",
            "estimated"
          ],
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "totalTokens": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Totaltokens"
        }
      },
      "required": [
        "status",
        "reason",
        "inputTokens",
        "outputTokens",
        "totalTokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "analysis.delta": "#/$defs/AnalysisDelta",
      "content.delta": "#/$defs/ContentDelta",
      "error": "#/$defs/ProviderError",
      "finish": "#/$defs/ProviderFinish",
      "tool.arguments.delta": "#/$defs/ToolArgumentsDelta",
      "tool.complete": "#/$defs/ToolCallComplete",
      "usage": "#/$defs/ProviderUsage"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ContentDelta"
    },
    {
      "$ref": "#/$defs/AnalysisDelta"
    },
    {
      "$ref": "#/$defs/ToolArgumentsDelta"
    },
    {
      "$ref": "#/$defs/ToolCallComplete"
    },
    {
      "$ref": "#/$defs/ProviderUsage"
    },
    {
      "$ref": "#/$defs/ProviderFinish"
    },
    {
      "$ref": "#/$defs/ProviderError"
    }
  ]
}
