{
  "$defs": {
    "AuditEntry": {
      "additionalProperties": false,
      "properties": {
        "contentDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contentdigest",
          "type": "string"
        },
        "kind": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Kind",
          "type": "string"
        },
        "payloadRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Payloadref",
          "type": "string"
        },
        "recordedAt": {
          "format": "date-time",
          "title": "Recordedat",
          "type": "string"
        },
        "sessionSeq": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sessionseq",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/AuditVisibility"
        }
      },
      "required": [
        "sessionSeq",
        "kind",
        "visibility",
        "recordedAt",
        "payloadRef",
        "contentDigest"
      ],
      "title": "AuditEntry",
      "type": "object"
    },
    "AuditVisibility": {
      "enum": [
        "public",
        "restricted"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AuditEntry"
      },
      "maxItems": 256,
      "title": "Entries",
      "type": "array"
    },
    "nextSeq": {
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Nextseq",
      "type": "string"
    },
    "restricted": {
      "const": true,
      "default": true,
      "title": "Restricted",
      "type": "boolean"
    },
    "scopeId": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
      "title": "Scopeid",
      "type": "string"
    },
    "sessionId": {
      "format": "uuid",
      "title": "Sessionid",
      "type": "string"
    }
  },
  "required": [
    "scopeId",
    "sessionId",
    "nextSeq"
  ],
  "title": "AuditQueryResult",
  "type": "object"
}
