        "actorId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Actorid",
          "type": "string"
        },
        "authRevision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Authrevision",
          "type": "string"
        },
        "grantsRef": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Grantsref",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "actorId",
        "authRevision",
        "grantsRef"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "WorkspaceVersion": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Generation",
          "type": "string"
        },
        "ownerRunId": {
          "format": "uuid",
          "title": "Ownerrunid",
          "type": "string"
        },
        "revision": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Revision",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s\\p{Cc}\\p{Cf}]+$",
          "title": "Scopeid",
          "type": "string"
        },
        "workspaceId": {
          "format": "uuid",
          "title": "Workspaceid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "workspaceId",
        "ownerRunId",
        "generation",
        "revision"
      ],
      "title": "WorkspaceVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorContext"
    },
    "expected": {
      "$ref": "#/$defs/WorkspaceVersion"
    },
    "idempotencyKey": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[\\x21-\\x7e]+$",
      "title": "Idempotencykey",
      "type": "string"
    }
  },
  "required": [
    "actor",
    "expected",
    "idempotencyKey"
  ],
  "title": "WorkspaceCheckpointRequest",
  "type": "object"
}
